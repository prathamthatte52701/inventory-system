# Where the admin-only "Admin" link in the navbar opens (the separate frontend-admin app).
# Optional; defaults to http://localhost:5174
VITE_ADMIN_URL=

# Only needed if the API is NOT reached through the Vite proxy (e.g. a production build served elsewhere).
# Its origin must also be listed in the backend's CORS_ORIGIN.
VITE_API_URL=
