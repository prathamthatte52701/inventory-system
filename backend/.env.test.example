# Copy this file to backend/.env.test and fill it in (git-ignored, same as .env). Same keys as .env.example,
# but MONGO_URI must point at a clearly test-named database — same Atlas cluster is fine, just a different
# database, e.g. append "_test" to whatever your real database is called
# (inventory_management -> inventory_management_test). Never reuse the real database's name here: the test
# suite refuses to run (see backend/utils/testEnvGuard.js) if the resolved database doesn't look like a test one.
MONGO_URI=
JWT_SECRET=
ADMIN1_NAME=
ADMIN1_EMAIL=
ADMIN1_PASSWORD=
ADMIN2_NAME=
ADMIN2_EMAIL=
ADMIN2_PASSWORD=
PORT=
# comma-separated; e.g. http://localhost:2000,http://localhost:5174  (user app, admin app)
CORS_ORIGIN=
COOKIE_SECURE=
